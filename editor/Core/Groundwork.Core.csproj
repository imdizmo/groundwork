<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything that is not the window: settings, the plugins, object ids, the log. Used by the app
       (Desktop) and the tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Groundwork.Core</AssemblyName>
    <RootNamespace>Groundwork</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Groundwork" />
    <InternalsVisibleTo Include="Desktop.Tests" />
    <InternalsVisibleTo Include="Core.Tests" />
    <!-- The Expand World add-on's tests: its rules followed by the editor's generator, placer and dungeons. -->
  </ItemGroup>
  <ItemGroup>
    <!-- The app's texts, a catalogue per language (App/Lang.cs). -->
    <EmbeddedResource Include="Lang/*.json" LogicalName="Groundwork.Lang.%(Filename).json" />
  </ItemGroup>
  <ItemGroup>
    <!-- The API mods' editor extensions are built against (App/ModExtensions.cs). -->
    <ProjectReference Include="../../sdk/Groundwork.Sdk/Groundwork.Sdk.csproj" />
  </ItemGroup>
</Project>
